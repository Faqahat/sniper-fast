#!/bin/bash
# runs keeper.sh every 10 min, then (dip21; ops/strategies/presend/filter/QUIET_BOOK.md) the QUIET BOOK: quiet_book extends the host's
# 24 h whale dump history from the copies keeper.sh just made (only the new chunks), quiet_book_push.sh gives it (and a changed
# cohort / follower-bot list) to every node in ops/collect/nodes.txt. A failed build or push leaves the previous book everywhere.
# Start: setsid nohup bash /home/it/sniper/ops/collect/keeper_loop.sh > /dev/null 2>&1 &
echo $$ > /data/tapes/collect/keeper_loop.pid
QB=/home/it/sniper-data/quiet_book
mkdir -p $QB
while true; do
  timeout 3000 bash /home/it/sniper/ops/collect/keeper.sh
  timeout 1200 nice -n 10 ionice -c 3 /home/it/sniper-data/speed_fixes/bin/quiet_book >> $QB/build.log 2>&1
  timeout 600 bash /home/it/sniper/ops/collect/quiet_book_push.sh > /dev/null 2>&1
  sleep 600
done
