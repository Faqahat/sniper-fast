{ [ -n "$USE16" ] || [ -n "$USE18" ]; } && printf %s ",$PROBEPATHS,$ROUTES," | grep -q glaive && cat "$GLAIVE_SIDE" >> $PC
# falcon-udp side file (dip18 kind): appended only when this run names falcon-udp
[ -n "$USE18" ] && printf %s ",$PROBEPATHS,$ROUTES," | grep -q 'falcon-udp' && cat "$FUDP_SIDE" >> $PC
# Soyas / Solami side file (dip18): appended only when this run names soyas or solami
[ -n "$USEQ" ] && cat "$QUIC_SIDE" >> $PC
# 0slot side file (kind 0slot exists in every dip engine): appended only when this run names 0slot
ZS_SIDE=/root/sniper-dip/paths_0slot.toml
if printf %s ",$PROBEPATHS,$ROUTES," | grep -q '0slot'; then [ -f "$ZS_SIDE" ] || die "missing $ZS_SIDE"; cat "$ZS_SIDE" >> $PC; fi
# probe-only paths (enabled = false in the base config): a probe run switches on exactly the ones it names, in this run's copy
# (also the paths a ROUTES string names, e.g. falcon in routes v10)
if [ -n "$PROBEPATHS$ROUTES" ]; then
  for n in $( { printf %s "$PROBEPATHS" | tr ',' '\n'; printf %s "$ROUTES" | tr ';' '\n' | sed 's/^[^=]*=//' | tr '+' '\n'; } | sort -u); do
    awk -v n="$n" '/^\[\[send\]\]/{inb=0} $0 ~ ("^name *= *\"" n "\"") {inb=1} inb && /^enabled *= *false/ {sub(/false/, "true")} {print}' $PC > $PC.tmp && mv $PC.tmp $PC
  done
fi
grep -q "^wallet *= *\"$W\"" $PC && grep -q "^wallet_keystore *= *\"$KS\"" $PC && grep -q 'kind    = "yellowstone-tx"' $PC || die "could not build $PC"

# budget across runs (the read-only RPC helper needs its token from the .env)
CONSTANTK_TOKEN=$(bash -c 'set -a; . /root/sniper/deploy/.env; printf %s "${CONSTANTK_TOKEN:-}"'); export CONSTANTK_TOKEN
read BAL REMAIN FIRST < <(python3 - "$W" "$BUDGETF" <<'EOF'
import sys, json, os
sys.path.insert(0, "/root/indep")
from common import rpc
W = sys.argv[1]; P = sys.argv[2]
bal = rpc("getBalance", [W])["value"]
b = json.load(open(P)) if os.path.exists(P) else {"first_start": bal, "max_total_loss": 500_000_000, "runs": []}
if not os.path.exists(P): json.dump(b, open(P, "w"), indent=1)
lost = max(0, b["first_start"] - bal)
print(bal, b["max_total_loss"] - lost, b["first_start"])
EOF
)
[ -n "${BAL:-}" ] || die "could not read the wallet balance"
awk -v r="$REMAIN" 'BEGIN{exit !(r >= 50000000)}' || die "the dip budget is used up: lost $(( (FIRST-BAL)/1000000 )) mSOL of 500 since the first run"
[ -z "$PSLIVE" ] || awk -v f="${PSV[--presend-live-fee-budget-sol]}" -v r="$REMAIN" 'BEGIN{exit !(f*1e9 <= r)}' || die "--presend-live-fee-budget-sol exceeds the dip budget left"
awk -v b="$BAL" -v s="$MAXSIZE" 'BEGIN{exit !(b >= s*1e9 + 60000000)}' || die "balance $BAL lamports is below size + 0.06 SOL"
LOSS=$(awk -v r="$REMAIN" 'BEGIN{printf "%.4f", r/1e9}')
LAM=$(awk -v s="$SIZE" 'BEGIN{printf "%d", s*1e9}')
MAXSOL=$(awk -v s="$MAXSIZE" 'BEGIN{printf "%.4f", s*1.05}')
BUDGET=$(awk -v s="$MAXSIZE" -v n="$TRADES" 'BEGIN{printf "%.3f", n*(s*1.02+0.02)+0.1}')
TAG=${TAGP}${RUN}
echo "DIP LIVE [$REGION] run $RUN (wallet $W): $TRADES trades x $SIZE SOL, tier $TIER, take-profit $( [ "$TP" = 99 ] && echo off || echo "+$TP" ), stop -$SL, hold $HOLD slots (~$(awk -v h=$HOLD 'BEGIN{printf "%.1f", h*0.212}') s), guard x$GUARD, open $OPEN at a time, $MIN min$( [ -n "$DEVLIST" ] && echo " | dev list $DEVLIST: $DEVTIER at $DEVSIZE SOL" )$( [ -n "$NEAR" ] && echo " | near leaders only: $NEAR ($(grep -c . "$NEAR") leaders)" )$( [ -n "$NONCE" ] && echo " | NONCE fan-out: $NONCE ($(grep -v '^#' "$NONCE" | grep -c '[1-9A-HJ-NP-Za-km-z]\{32,44\}') accounts)" )$M2DESC$PSDESC$PSLDESC$QDESC$SFDESC$D14DESC | backup RPC $FBDESC | wallet balance $(awk -v b=$BAL 'BEGIN{printf "%.4f", b/1e9}') SOL | kill switch at -$LOSS SOL (budget left of 0.5) | priority ${PRIO} uL/CU | routes $ROUTES"
echo "log: /root/prod/runs/$TAG.log  records: /root/prod/runs/$TAG.jsonl"
python3 - "$RUN" "$TRADES" "$SIZE" "$BAL" "$TP" "${DEVSIZE:-0}" "$BUDGETF" "$REGION" <<'EOF'
import sys, json, time
P = sys.argv[7]; b = json.load(open(P))
b["runs"].append({"run": int(sys.argv[1]), "trades": int(sys.argv[2]), "size": float(sys.argv[3]), "start_balance": int(sys.argv[4]), "t_start": int(time.time()),
                  "tp": float(sys.argv[5]), "dev_size": float(sys.argv[6]), "region": sys.argv[8]})
json.dump(b, open(P, "w"), indent=1)
EOF
# the engine writes STRAIGHT to the log (no pipe a Ctrl-c could kill: a dead pipe makes its next log line panic and breaks
# the exit of an open position); the live view is a tail in its OWN session, so Ctrl-c reaches only the engine (no new
# buys, open positions finish their exit, then DIP DONE) and this script
LOG=/root/prod/runs/$TAG.log
: >> "$LOG"
setsid tail -n 0 -F "$LOG" &
TAILPID=$!
trap 'echo; echo "(Ctrl-c -> engine: no new buys; an open position finishes its exit; wait for PROD_DIP_DONE)"' INT
echo "the engine now asks for the keystore passphrase (hidden):"
$B --dip --live --fast-send --jito-h2 --fast-presign --fast-derive --fast-verify \
  --dip-tier $TIER --dip-allow-holder --dip-tp $TP --dip-sl $SL --dip-hold-slots $HOLD --dip-guard $GUARD --dip-spacing-slots 5 ${DEVARGS[@]+"${DEVARGS[@]}"} ${NEARARGS[@]+"${NEARARGS[@]}"} ${NONCEARGS[@]+"${NONCEARGS[@]}"} ${M2ARGS[@]+"${M2ARGS[@]}"} ${PSARGS[@]+"${PSARGS[@]}"} ${PSLARGS[@]+"${PSLARGS[@]}"} ${QARGS[@]+"${QARGS[@]}"} ${SFARGS[@]+"${SFARGS[@]}"} ${D14ARGS[@]+"${D14ARGS[@]}"} \
  --dip-model /root/dip/IMIT1.json --dip-cohort /root/dip/cohort_train.json --dip-log /root/prod/runs/$TAG.jsonl \
  --spend-lamports $LAM --max-sol $MAXSOL --max-total-sol $BUDGET --max-buys $TRADES --max-inflight $OPEN --max-loss-sol $LOSS --minutes $MIN \
  --cu-limit 100000 --cu-price-micro $PRIO --sell-cu-limit 120000 --sell-cu-price-micro 5000000 \
  --land-poll-ms 100 --land-timeout-ms 3000 --sell-robust --sell-retry-s 1 --sell-deadline-s 30 --sell-fallback-path nozomi \
  --buy-max-slot-delta 1 --rpc-fallback-url-env $FBVAR --env-name $ENVNAME --strict-balance --ks-blind-s 10 \
  --send-path helius --sell-path staked-rpc --route-by-client "$ROUTES" --no-union-harmonic \
  --config $PC --env-file /root/sniper/deploy/.env >> "$LOG" 2>&1
RC=$?
sleep 1; kill $TAILPID 2>/dev/null
trap - INT
echo "engine exit code $RC"
python3 - "$W" "$BUDGETF" <<'EOF'
import sys, json, time
sys.path.insert(0, "/root/indep")
from common import rpc
P = sys.argv[2]; b = json.load(open(P))
bal = rpc("getBalance", [sys.argv[1]])["value"]
b["runs"][-1].update(end_balance=bal, t_end=int(time.time())); json.dump(b, open(P, "w"), indent=1)
print(f"DIP run end: balance {bal / 1e9:.4f} SOL; since the first dip run {(bal - b['first_start']) / 1e9:+.4f} SOL (budget left {(b['max_total_loss'] - max(0, b['first_start'] - bal)) / 1e9:.4f} of 0.5)")
EOF
# LEFTOVER-TOKEN CHECK (10-26, after FRA run 22 left 11.8M tokens unsold): every token account of the wallet with a balance,
# read on chain after the engine exits; anything left is printed loud with the exact sell command (the engine's own checks can miss)
python3 - "$W" "$PC" <<'EOF'
import sys
sys.path.insert(0, "/root/indep")
from common import rpc
W, PC = sys.argv[1], sys.argv[2]
left, bad = [], False
for prog in ("TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb", "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"):
    r = rpc("getTokenAccountsByOwner", [W, {"programId": prog}, {"encoding": "jsonParsed", "commitment": "confirmed"}])
    if not isinstance(r, dict) or "value" not in r: bad = True; continue
    for a in r["value"]:
        i = a["account"]["data"]["parsed"]["info"]
        # frozen accounts are someone else's spam airdrop (10-26: 1B ByiDNcxM… minted to the AMS wallet, then frozen): never ours, never sold
        if i.get("state") == "frozen": continue
        if i["mint"] != "So11111111111111111111111111111111111111112" and int(i["tokenAmount"]["amount"]) > 0: left.append((i["mint"], i["tokenAmount"]["uiAmountString"]))
if bad: print("LEFTOVER-TOKEN CHECK: could not read the token accounts -- check the wallet by hand before the next run")
elif not left: print("LEFTOVER-TOKEN CHECK: no tokens left in the wallet")
else:
    print("!" * 100)
    print(f"LEFTOVER TOKENS IN THE WALLET: {len(left)} mint(s) -- SELL THEM NOW:")
    for m, ui in left: print(f"  {m}  {ui} tokens")
    print("  sudo /root/sniper-dip/snipe_engine_dip18 --sell-held " + ",".join(m for m, _ in left) + f" --live --env-name PROD --config {PC} --env-file /root/sniper/deploy/.env --send-path helius --sell-path staked-rpc --sell-fallback-path nozomi --sell-robust --sell-retry-s 1 --sell-deadline-s 60 --sell-cu-limit 120000 --sell-cu-price-micro 5000000")
    print("!" * 100)
EOF
