#     routes v7: jito = helius (Sender default/dual routing, 0.001) + nozomi + staked-rpc (was nozomi + helius-swqos + bolt +
#     staked-rpc): our Jito-leader buys took 91 ms median (25% fill); rivals' Helius copies land first there.
#   run 5 (owner 10-24 06:25 PKT: "for next run lets do 1.3 and 0.75 for this dev tier"), engine dip9:
#   sudo bash /root/prod/run_dip_prod.sh --run 5 --trades 10 --size 0.35 --tp off --dev-list /root/sniper-dip/dev_list.txt --dev-size 0.75
#     --tp off: no take-profit; stop-loss -10% or sold by 6 slots (~1.3 s). Live fills runs 1-4: +0.630 vs +0.356 (TP +5%).
#     --dev-list: tokens created (signed or creator) by a listed wallet (bwamJzzt..., ops/overnight/sel/haqq_dev.py) are picked
#     from --dev-tier (default wider) and bought at --dev-size; everything else strict at --size.
#   routes v6 (10-24 05:40 PKT, from haqqiUUX's landed copies: Helius SWQoS-only 0.0002 wins 58% BAM / 83% Harmonic / 57% Jito,
#   his tipless staked copy wins 85% on Firedancer): helius-swqos on bam/jito/harmonic/other, fd = nozomi + landx + staked.
#   v5 (10-24 05:05 PKT, owner: "3rd option like haqq": Helius SWQoS-only tier 0.0002 replaces Helius, the tipless
#   staked RPC added to every class; probe E: nozomi 35 / staked-rpc 42 / helius-swqos 58 / bolt 60 / helius 65 ms fire->seen).
#   v4 (owner 10-24 04:20 PKT: 3 paths per leader for run 3; landing probes A-D, ops/dip/speed/probe_timing.py; D = 70 probes, nearby leaders, 7 paths): two fastest
#   paths per leader client; base config dip_probe.toml (adds bolt / haan / tpu-direct); engine dip8 (+ timing records)
#   optional: --tier strict|wider (strict)  --guard 1.05 (owner 10-24: 2% blocked ~all buys)  --minutes 120  --prio-micro 5000000 (priority 0.0005 SOL at 100k CU)
#             --routes "<class=path+path;...>"  --open 1 (positions at a time)
#   stop cleanly: Ctrl-c in the tmux window (no new buys; open positions finish their exit), then wait for "PROD_DIP_DONE"
#
# Strategy (frozen; ops/overnight/sel/SELECTION.md, src/dip_imit.rs parity 2097/2097): IMIT1 selector, buy right after a
# >= 1 SOL dump, guard (min tokens = post-dump quote / --guard, default 1.05), on-chain slot deadline (dump slot + 1), exit take-profit +5% /
# stop-loss -10% / sell by 6 slots (~1.3 s), one token at a time.
set -u
die() { echo "REFUSED: $*" >&2; exit 1; }
RUN= TRADES= SIZE= TIER=strict MIN=120 PRIO=5000000 OPEN=1 GUARD=1.05 TP=0.05 DEVLIST= DEVSIZE= DEVTIER=wider NEAR= REGION=fra HOLD=6 SL=0.10 NONCE= FALLBACK=RMR_RPC_URL M2= M2MODE=shadow M2MIN= M2EXTRA= PRESEND=
PSLIVE= PSDRY= SELLFAN= PSWHALE= PSQUIET= PSTP= PSV2= PSWIDE= PSF3= PSEQ= PSQ4= PSMOVE=
REGULAR=live REGPMS= PLOCK= OBS= SIZEDEF=
QSTOPV=6:2 QFOLV=2.24 QFBV=/root/dip/fbots_frozen.json   # dip25 (10-29 PKT): --quiet-stop / --quiet-fol / --quiet-fbots (QUIET3 recalibration)   # dip24 draft (10-29 PKT): --regular, --regular-paper-ms, --profit-lock, --observatory
PSREARM= PSREARMSIZE= PSREARMGAP= PSREARMQ= PSREARMR5=   # dip26 draft (10-29 PKT): --presend-rearm [on|off], --presend-rearm-size / -gap / -quiet / -r5
declare -A PSV=()
declare -A D16V=(); D16RH= D16WC=
SHRED= SHREDIDX= SHREDWIN= SHREDMARGIN= SHREDSELLER= SKIPCL= DEFER= BUSY= PINCORE= CLOCK2= FEEDLAG= PROBE= PROBEPATHS= PROBECL= PROBETIPLESS= PROBEGAP=
ROUTES="bam=nozomi+helius-swqos+bolt+staked-rpc;jito=helius+nozomi+jito-bundle+staked-rpc;harmonic=nozomi+helius-swqos+landx-fra3+staked-rpc;fd=nozomi+landx-fra3+staked-rpc;agave=nozomi+helius-swqos+bolt+staked-rpc;other=nozomi+helius-swqos+bolt+staked-rpc;default=nozomi+helius-swqos+bolt+staked-rpc"
while [ $# -gt 0 ]; do
  case "$1" in
    --run) RUN=$2; shift 2;; --trades) TRADES=$2; shift 2;; --size) SIZE=$2; shift 2;; --tier) TIER=$2; shift 2;;
    --minutes) MIN=$2; shift 2;; --prio-micro) PRIO=$2; shift 2;; --routes) ROUTES=$2; shift 2;; --open) OPEN=$2; shift 2;; --guard) GUARD=$2; shift 2;;
    --tp) TP=$2; shift 2;; --dev-list) DEVLIST=$2; shift 2;; --dev-size) DEVSIZE=$2; shift 2;; --dev-tier) DEVTIER=$2; shift 2;;
    --near) NEAR=$2; shift 2;; --region) REGION=$2; shift 2;; --hold-slots) HOLD=$2; shift 2;; --sl) SL=$2; shift 2;;
    --nonce) NONCE=$2; shift 2;;
    --fallback) FALLBACK=$2; shift 2;;
    --m2) M2=$2; shift 2;; --m2-mode) M2MODE=$2; shift 2;; --m2-min) M2MIN=$2; shift 2;; --m2-extra) M2EXTRA=$2; shift 2;;
    --presend) PRESEND=1; shift;;
    --presend-whale-pct) PSWHALE=$2; shift 2;;
    --presend-wide-pct) PSWIDE=$2; shift 2;;
    --presend-tp) PSTP=$2; shift 2;;
    --presend-live) PSLIVE=1; shift;;
    --presend-live-dry) PSDRY=1; shift;;
    --presend-quiet) PSQUIET=1; shift;;
    --presend-quiet-v2-log) PSV2=1; shift;;
    # dip26 draft (10-29 PKT): the LIVE RE-ARM (engine --presend-live-rearm*; off unless --presend-rearm)
    --presend-rearm) PSREARM=1; shift; case "${1:-}" in on) shift;; off) PSREARM=; shift;; esac;;
    --presend-rearm-size|--presend-rearm-gap|--presend-rearm-quiet|--presend-rearm-r5) [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in --presend-rearm-size) PSREARMSIZE=$2;; --presend-rearm-gap) PSREARMGAP=$2;; --presend-rearm-quiet) PSREARMQ=$2;; --presend-rearm-r5) PSREARMR5=$2;; esac; shift 2;;
    --presend-live-size-sol|--presend-live-k|--presend-live-drop|--presend-live-deadline-slots|--presend-live-cu-limit|--presend-live-cu-price-micro|--presend-live-tip-lamports|\
    --presend-live-routes|--presend-live-max-per-sec|--presend-live-path-max-per-sec|--presend-live-max-fills|--presend-live-fee-budget-sol|--presend-live-create-slot|\
    --presend-live-one-position|--presend-live-exit-ms|--presend-live-min-age-slots|--presend-live-lone-whale-slots|--presend-live-ann|--presend-live-deep-drop|--presend-live-holds-state|\
    --presend-live-breaker|--presend-live-cr-loss|--presend-live-creator-state|--presend-live-quiet3a|--presend-live-tag-wallets|\
    --presend-live-exact-exit|--presend-live-cr-earn-log|--presend-live-seen-log) [ $# -ge 2 ] || die "$1 needs a value"; PSV["$1"]=$2; shift 2;;
    --presend-live-f3-log) PSF3=1; shift;;
    # dip34 log-only switches
    --presend-live-eqgrp-log) PSEQ=1; shift;;
    --presend-live-q4-log) PSQ4=1; shift;;
    --presend-move-log) PSMOVE=1; shift;;
    --sell-fanout) SELLFAN=$2; shift 2;;
    --loaded-data-limit|--probe-nonce|--probe-lock-only|--probe-lock-cu) [ $# -ge 2 ] || die "$1 needs a value"; D16V["$1"]=$2; shift 2;;
    --route-headers) D16RH=1; shift;; --window-clock) D16WC=1; shift;;
    --shred-fire|--shred-index|--shred-window|--shred-margin|--shred-seller-check|--skip-clients|--pin-core|--probe|--probe-paths|--probe-clients|--probe-tipless|--probe-gap-ms)
      [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in --shred-fire) SHRED=$2;; --shred-index) SHREDIDX=$2;; --shred-window) SHREDWIN=$2;; --shred-margin) SHREDMARGIN=$2;; --shred-seller-check) SHREDSELLER=$2;;
        --skip-clients) SKIPCL=$2;; --pin-core) PINCORE=$2;; --probe) PROBE=$2;; --probe-paths) PROBEPATHS=$2;; --probe-clients) PROBECL=$2;; --probe-tipless) PROBETIPLESS=$2;;
        --probe-gap-ms) PROBEGAP=$2;; esac; shift 2;;
    --defer) DEFER=1; shift;; --busy-poll) BUSY=1; shift;; --clock2) CLOCK2=1; shift;; --feed-lag) FEEDLAG=1; shift;;
    # dip24 draft (10-29 PKT): OBSERVATORY, REGULAR MODE, the profit lock
    --observatory) OBS=1; shift;;
    --quiet-stop) QSTOPV=$2; shift 2;; --quiet-fol) QFOLV=$2; shift 2;; --quiet-fbots) QFBV=$2; shift 2;;
    --regular|--regular-paper-ms|--profit-lock) [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in --regular) REGULAR=$2;; --regular-paper-ms) REGPMS=$2;; --profit-lock) PLOCK=$2;; esac; shift 2;;
    *) die "unknown argument $1";;
  esac
done
# REGULAR MODE (dip24 draft, owner 10-29 02:05 PKT): live (default) needs --run, --trades and --size as before; paper takes the same
# inputs as live (--size required) but --trades is optional (default 0 = no cap); off: --trades optional (default 0) and --size optional
# (default: the --presend-live-size-sol value, else 0.25; it still sets --spend-lamports / --max-sol)
[[ "$REGULAR" =~ ^(live|paper|off)$ ]] || die "--regular live|paper|off (got '$REGULAR')"
case "$REGULAR" in
  live)  [ -n "$RUN" ] && [ -n "$TRADES" ] && [ -n "$SIZE" ] || die "--run, --trades and --size are required";;
  paper) [ -n "$RUN" ] && [ -n "$SIZE" ] || die "--run and --size are required (--regular paper takes the same inputs as live; --trades is optional)"
         TRADES=${TRADES:-0};;
  off)   [ -n "$RUN" ] || die "--run is required"
         TRADES=${TRADES:-0}
         if [ -z "$SIZE" ]; then
           if [ -n "${PSV[--presend-live-size-sol]:-}" ]; then SIZE=${PSV[--presend-live-size-sol]}; SIZEDEF="default: the --presend-live-size-sol value"
           else SIZE=0.25; SIZEDEF="default 0.25"; fi
           [[ "$SIZE" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--presend-live-size-sol: '$SIZE' is not a number"
         fi;;
esac
REGARGS=(); REGDESC="regular LIVE"
if [ -n "$REGPMS" ]; then
  [ "$REGULAR" = paper ] || die "--regular-paper-ms needs --regular paper"
  [[ "$REGPMS" =~ ^[0-9]+$ ]] && [ "$REGPMS" -ge 1 ] && [ "$REGPMS" -le 2000 ] || die "--regular-paper-ms must be 1..2000 (ms)"
fi
case "$REGULAR" in
  paper) REGARGS=(--dip-regular paper); [ -z "$REGPMS" ] || REGARGS+=(--dip-regular-paper-ms "$REGPMS")
         REGDESC="regular PAPER (never sent; paper landing $( [ -n "$REGPMS" ] && echo "$REGPMS ms" || echo "at the engine's default" ))";;
  off)   REGARGS=(--dip-regular off); REGDESC="regular OFF (no regular buys; dumps still logged)";;
esac
[[ "$RUN" =~ ^[0-9]+$ ]] && [[ "$TRADES" =~ ^[0-9]+$ ]] && [[ "$MIN" =~ ^[0-9]+$ ]] && [[ "$PRIO" =~ ^[0-9]+$ ]] && [[ "$OPEN" =~ ^[0-9]+$ ]] || die "integers expected"
[[ "$SIZE" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--size: not a number"
awk -v s="$SIZE" 'BEGIN{exit !(s>=0.05 && s<=1.0)}' || die "--size must be 0.05..1.0 SOL${SIZEDEF:+ (size $SIZE = the regular-off $SIZEDEF)}"
# dip24 draft (owner 10-29 02:10 PKT "remove any hard limits on fills, run time etc."): --trades was 1..1500 and --minutes 1..720; now
# any whole number >= 0 (--trades 0 = unlimited regular live buys, --minutes 0 = no time limit). Only a length check is left: the
# engine reads a number it cannot parse as its DEFAULT without a word, so more than 9 digits is refused
[ "${#TRADES}" -le 9 ] || die "--trades: more than 9 digits (the engine would silently use its default); 0 = unlimited"
[ "${#MIN}" -le 9 ] || die "--minutes: more than 9 digits (the engine would silently use its default); 0 = no time limit"
[ "$OPEN" -ge 1 ] && [ "$OPEN" -le 3 ] || die "--open must be 1..3"
[ "$PRIO" -le 50000000 ] || die "--prio-micro above 50M (0.005 SOL priority): refusing"
case "$TIER" in strict|wider) ;; *) die "--tier strict|wider";; esac
awk -v g="$GUARD" 'BEGIN{exit !(g>=1.0 && g<=1.10)}' || die "--guard must be 1.00..1.10 (max price above the post-dump price)"
[[ "$HOLD" =~ ^[0-9]+$ ]] && [ "$HOLD" -ge 3 ] && [ "$HOLD" -le 60 ] || die "--hold-slots must be 3..60 (6 = ~1.3 s, 19 = ~4 s)"
awk -v x="$SL" 'BEGIN{exit !(x>=0.03 && x<=0.5)}' || die "--sl must be 0.03..0.5"
case "$TP" in off) TP=99;; *) awk -v t="$TP" 'BEGIN{exit !(t>=0.01 && t<=1.0)}' || die "--tp must be off or 0.01..1.0";; esac
# --profit-lock M[,F] (dip24 draft, owner 10-29 02:20 PKT; off unless given; replaces --max-drawdown-sol, dropped): engine
# --profit-lock-min-sol M --profit-lock-frac F (both passed; F default 0.30). Give-back G = max(M, F x (peak - start)) on the run's PEAK
# balance (balance + open positions at cost); below max(start - LOSS, peak - G) the run stops like the kill switch ("profit_lock")
PLARGS=(); PLDESC="profit lock none"
if [ -n "$PLOCK" ]; then
  [[ "$PLOCK" =~ ^([0-9]+([.][0-9]+)?)(,([0-9]+([.][0-9]+)?))?$ ]] || die "--profit-lock M[,F]: M in SOL, F a fraction (e.g. 2 or 2,0.30; got '$PLOCK')"
  PLM=${BASH_REMATCH[1]}; PLF=${BASH_REMATCH[4]:-0.30}
  awk -v x="$PLM" 'BEGIN{exit !(x>0 && x<=100)}' || die "--profit-lock: M must be in (0, 100] SOL (the minimum give-back)"
  awk -v x="$PLF" 'BEGIN{exit !(x>0 && x<=1)}' || die "--profit-lock: F must be a fraction in (0, 1] (the share of the peak profit that may be given back)"
  PLARGS=(--profit-lock-min-sol "$PLM" --profit-lock-frac "$PLF"); PLDESC="profit lock: give back max($PLM SOL, $PLF x peak profit)"
fi
DEVARGS=()
MAXSIZE=$SIZE
if [ -n "$DEVLIST" ]; then
  [ -s "$DEVLIST" ] || die "--dev-list $DEVLIST: missing or empty"
  grep -v '^#' "$DEVLIST" | grep -q '[1-9A-HJ-NP-Za-km-z]\{32,44\}' || die "--dev-list $DEVLIST: no wallet address in it"
  [ -n "$DEVSIZE" ] || DEVSIZE=$SIZE
  [[ "$DEVSIZE" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--dev-size: not a number"
  awk -v s="$DEVSIZE" 'BEGIN{exit !(s>=0.05 && s<=1.0)}' || die "--dev-size must be 0.05..1.0 SOL"
  case "$DEVTIER" in strict|wider) ;; *) die "--dev-tier strict|wider";; esac
  DEVARGS=(--dip-dev-list "$DEVLIST" --dip-dev-tier "$DEVTIER" --dip-dev-spend-lamports "$(awk -v s="$DEVSIZE" 'BEGIN{printf "%d", s*1e9}')")
  MAXSIZE=$(awk -v a="$SIZE" -v b="$DEVSIZE" 'BEGIN{print (b>a)?b:a}')
fi
awk -v s="$MAXSIZE" -v o="$OPEN" 'BEGIN{exit !(s*o <= 1.5)}' || die "size x open positions exceeds the 1.5 SOL usable budget"
# PRE-SEND LIVE: its size within the per-buy cap (--max-sol); with one position off it may hold one more position
PSSIZE=${PSV[--presend-live-size-sol]:-0}
if [ -n "$PSLIVE" ]; then
  MAXSIZE=$(awk -v a="$MAXSIZE" -v b="$PSSIZE" 'BEGIN{print (b>a)?b:a}')
  if [ "${PSV[--presend-live-one-position]:-on}" = off ]; then awk -v s="$MAXSIZE" -v o="$OPEN" -v p="$PSSIZE" 'BEGIN{exit !(s*o + p <= 1.5)}' || die "size x open + the pre-send size exceeds the 1.5 SOL usable budget"; fi
fi
NEARARGS=()
if [ -n "$NEAR" ]; then
  [ -s "$NEAR" ] || die "--near $NEAR: missing or empty"
  [ "$(grep -c '[1-9A-HJ-NP-Za-km-z]\{32,44\}' "$NEAR")" -ge 20 ] || die "--near $NEAR: fewer than 20 leader identities"
  NEARARGS=(--dip-near-leaders "$NEAR")
fi
NONCEARGS=()
if [ -n "$NONCE" ]; then
  [ -s "$NONCE" ] || die "--nonce $NONCE: missing or empty (make it with ops/prod/nonce_accounts.sh --region $REGION --count 8 --live)"
  [ "$(grep -v '^#' "$NONCE" | grep -c '[1-9A-HJ-NP-Za-km-z]\{32,44\}')" -ge 1 ] || die "--nonce $NONCE: no account address in it"
  NONCEARGS=(--nonce-fanout --nonce-accounts "$NONCE")
fi
# OBSERVATORY (dip24 draft, owner 10-29 ~01:50 PKT): log-only shadow modules on their own thread, zero sends; the watch list must be on
# the server (one wallet per line, # comments)
OBSW=/root/sniper-dip/obs_watch.txt
OBSARGS=()
if [ -n "$OBS" ]; then
  [ -s "$OBSW" ] || die "--observatory: $OBSW missing or empty (copy ops/obs/watch_default.txt there first)"
  grep -v '^#' "$OBSW" | grep -q '[1-9A-HJ-NP-Za-km-z]\{32,44\}' || die "--observatory: no wallet address in $OBSW (copy ops/obs/watch_default.txt there first)"
  OBSARGS=(--observatory --obs-watch "$OBSW")
fi

in_tmux() { local p=$$; while [ "${p:-1}" -gt 1 ]; do case "$(ps -o comm= -p "$p" 2>/dev/null)" in tmux*) return 0;; esac; p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' '); done; return 1; }
[ -n "${TMUX:-}" ] || in_tmux || die "start inside tmux (tmux new -s dip), so an SSH drop cannot stop it"
[ -t 0 ] || die "stdin must be your terminal: the engine asks for the keystore passphrase"
pgrep -x snipe_engine >/dev/null && die "a snipe_engine is running (paper / shadow / prod): stop it first (one engine per server)"
pgrep -f "snipe_engine_dip" >/dev/null && die "a dip engine is running: stop it first"

case "$REGION" in
  fra) W=2g7rYv7yCQuNsxUfr5B61LBfkhYzHMhYTZkcZ6e2iTLE; KS=/root/prod/wallet-prod.enc; BASECFG=/root/sniper-dip/dip_probe.toml
       BUDGETF=/root/prod/dip_budget.json; PC=/root/prod/dip_prod.toml; TAGP=dip_r; ENVNAME=PROD;;
  ams) [ -s /root/prod/wallet-ams.address ] || die "missing /root/prod/wallet-ams.address (the Amsterdam wallet's public key)"
       W=$(tr -d ' \n\r' < /root/prod/wallet-ams.address); KS=/root/prod/wallet-ams.enc; BASECFG=/root/sniper-dip/dip_edge_ams.toml
       BUDGETF=/root/prod/dip_budget_ams.json; PC=/root/prod/dip_ams.toml; TAGP=dip_ams_r; ENVNAME=PROD;;   # the engine accepts only DEV | PROD
  *) die "--region fra|ams";;
esac
[[ "$W" =~ ^[1-9A-HJ-NP-Za-km-z]{32,44}$ ]] || die "wallet address for region $REGION looks wrong"
[ -f "$BASECFG" ] || die "missing $BASECFG (region $REGION base config)"
# a [[send]] path of the base config (its name line)
has_path() { grep -q "^name *= *\"$1\"" "$BASECFG" || { [ -f /root/sniper-dip/paths_glaive.toml ] && grep -q "^name *= *\"$1\"" /root/sniper-dip/paths_glaive.toml; } || { [ -f /root/sniper-dip/paths_falcon_udp.toml ] && grep -q "^name *= *\"$1\"" /root/sniper-dip/paths_falcon_udp.toml; } || { [ -f /root/sniper-dip/paths_quic.toml ] && grep -q "^name *= *\"$1\"" /root/sniper-dip/paths_quic.toml; } || { [ -f /root/sniper-dip/paths_0slot.toml ] && grep -q "^name *= *\"$1\"" /root/sniper-dip/paths_0slot.toml; }; }
# ASTRA (10-29): one field of a [[send]] block, by the block's name, from the base config or a side file ("" when absent)
path_field() { local f; for f in "$BASECFG" /root/sniper-dip/paths_glaive.toml /root/sniper-dip/paths_falcon_udp.toml /root/sniper-dip/paths_quic.toml /root/sniper-dip/paths_0slot.toml; do
    [ -f "$f" ] || continue
    awk -v n="$1" -v k="$2" '/^\[\[/{inb=0} $0 ~ ("^name *= *\"" n "\"") {inb=1} inb && $0 ~ ("^" k " *=") {sub(/^[^=]*= */, ""); sub(/ *#.*/, ""); gsub(/"/, ""); print; exit}' "$f" | grep . && return 0
  done; return 0; }
num() { [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]]; }
in_range() { awk -v x="$1" -v a="$2" -v b="$3" 'BEGIN{exit !(x>=a && x<=b)}'; }
PSLARGS=(); PSLDESC=""
# the two pre-send limits for the start line's LIMITS (set below when --presend-live is on)
PSFC="none (no pre-send live)"; PSFB="none (no pre-send live)"
if [ -n "$PSLIVE" ]; then
  [ -n "$PRESEND" ] || die "--presend-live needs --presend (the shadow: its records are the comparison)"
  # dip24 draft (owner 10-29 02:10 PKT): only the size is still a required cap; --presend-live-max-fills (absent or 0 = unlimited) and
  # --presend-live-fee-budget-sol (failed-try fees per ROLLING 24 h, pre-send pauses above it; engine default 1.0) are optional
  for f in --presend-live-size-sol; do [ -n "${PSV[$f]:-}" ] || die "--presend-live needs $f (a required cap)"; done
  for f in "${!PSV[@]}"; do case "$f" in --presend-live-routes|--presend-live-create-slot|--presend-live-one-position|--presend-live-ann|--presend-live-holds-state|--presend-live-breaker|--presend-live-cr-loss|--presend-live-creator-state|--presend-live-quiet3a|--presend-live-tag-wallets|--presend-live-exact-exit) ;; *) num "${PSV[$f]}" || die "$f: '${PSV[$f]}' is not a number";; esac; done
  [ -z "${PSV[--presend-live-max-fills]:-}" ] || [[ "${PSV[--presend-live-max-fills]}" =~ ^[0-9]+$ ]] || die "--presend-live-max-fills must be a whole number >= 0 (0 = unlimited)"
  [ -z "${PSV[--presend-live-fee-budget-sol]:-}" ] || awk -v x="${PSV[--presend-live-fee-budget-sol]}" 'BEGIN{exit !(x>0 && x<=100)}' || die "--presend-live-fee-budget-sol must be in (0, 100] SOL (the failed-try fees of a rolling 24 h; above it pre-send pauses)"
  PSFC=${PSV[--presend-live-max-fills]:-0}; [[ "$PSFC" =~ ^0+$ ]] && PSFC=unlimited
  PSFB="${PSV[--presend-live-fee-budget-sol]:-1.0 (engine default)} SOL of failed-try fees per rolling 24 h (above it pre-send pauses; never stops the run)"
  in_range "${PSV[--presend-live-size-sol]}" 0.05 1.0 || die "--presend-live-size-sol must be 0.05..1.0 SOL"
  [ -z "${PSV[--presend-live-k]:-}" ] || in_range "${PSV[--presend-live-k]}" 1 20 || die "--presend-live-k must be 1..20"
  [ -z "${PSV[--presend-live-drop]:-}" ] || awk -v x="${PSV[--presend-live-drop]}" 'BEGIN{exit !(x>0 && x<=0.5)}' || die "--presend-live-drop must be in (0, 0.5]"
  [ -z "${PSV[--presend-live-deadline-slots]:-}" ] || in_range "${PSV[--presend-live-deadline-slots]}" 1 8 || die "--presend-live-deadline-slots must be 1..8"
  [ -z "${PSV[--presend-live-cu-price-micro]:-}" ] || in_range "${PSV[--presend-live-cu-price-micro]}" 0 100000 || die "--presend-live-cu-price-micro above 100000: refusing"
  # (--presend-live-max-per-sec: checked after the routes below; ASTRA 10-29)
  [ -z "${PSV[--presend-live-path-max-per-sec]:-}" ] || in_range "${PSV[--presend-live-path-max-per-sec]}" 1 50 || die "--presend-live-path-max-per-sec must be 1..50"
  for f in --presend-live-create-slot --presend-live-one-position --presend-live-ann; do [ -z "${PSV[$f]:-}" ] || [[ "${PSV[$f]}" =~ ^(on|off)$ ]] || die "$f on|off"; done
  # dip22 (10-28, verify/REPORT.md): the pre-send "sell earlier" exit, N ms after the fill (0 = off); needs engine dip22
  [ -z "${PSV[--presend-live-min-age-slots]:-}" ] || in_range "${PSV[--presend-live-min-age-slots]}" 0 10 || die "--presend-live-min-age-slots must be 0..10 (dip25; 2 = also skip token age 1)"
  [ -z "${PSV[--presend-live-lone-whale-slots]:-}" ] || { [[ "${PSV[--presend-live-lone-whale-slots]}" =~ ^[0-9]+$ ]] && in_range "${PSV[--presend-live-lone-whale-slots]}" 0 64; } || die "--presend-live-lone-whale-slots must be a whole number 0..64 (dip27; 50 = the 10-30 loss study's rule)"
  [ -z "${PSV[--presend-live-deep-drop]:-}" ] || [ "${PSV[--presend-live-deep-drop]}" = 0 ] || awk -v x="${PSV[--presend-live-deep-drop]}" -v d="${PSV[--presend-live-drop]:-0.12}" 'BEGIN{exit !(x>d && x<=0.5)}' || die "--presend-live-deep-drop must be 0 (off) or deeper than the drop and <= 0.5 (dip28; 0.15 = the deeper limit)"
  [ -z "${PSV[--presend-live-holds-state]:-}" ] || [ "${PSV[--presend-live-ann]:-off}" = on ] || die "--presend-live-holds-state needs --presend-live-ann on (dip28)"
  # dip32: the breaker / creator ledger formats (the engine checks the ranges again)
  [ -z "${PSV[--presend-live-breaker]:-}" ] || [[ "${PSV[--presend-live-breaker]}" =~ ^[0-9]+:[0-9.]+:[0-9]+:[0-9]+$ ]] || die "--presend-live-breaker N:L:W:P, e.g. 2:0.2:10:30 (dip32)"
  [ -z "${PSV[--presend-live-cr-loss]:-}" ] || [[ "${PSV[--presend-live-cr-loss]}" =~ ^[0-9]+:[0-9.]+$ ]] || die "--presend-live-cr-loss N:SOL, e.g. 2:0.05 (dip32)"
  [ -z "${PSV[--presend-live-quiet3a]:-}" ] || [[ "${PSV[--presend-live-quiet3a]}" =~ ^(on|off)$ ]] || die "--presend-live-quiet3a on|off (dip33)"
  [ -z "${PSV[--presend-live-tag-wallets]:-}" ] || [[ "${PSV[--presend-live-tag-wallets]}" =~ ^[1-9A-HJ-NP-Za-km-z,]+$ ]] || die "--presend-live-tag-wallets W,W,... (dip33)"
  [ -z "${PSV[--presend-live-creator-state]:-}" ] || [ -n "${PSV[--presend-live-cr-loss]:-}" ] || die "--presend-live-creator-state needs --presend-live-cr-loss (dip32)"
  # dip34: the exact exit switch, the log-only values (the engine checks the ranges again)
  [ -z "${PSV[--presend-live-exact-exit]:-}" ] || [[ "${PSV[--presend-live-exact-exit]}" =~ ^(on|off)$ ]] || die "--presend-live-exact-exit on|off (dip34)"
  [ -z "${PSV[--presend-live-cr-earn-log]:-}" ] || awk -v x="${PSV[--presend-live-cr-earn-log]}" 'BEGIN{exit !(x>0 && x<=1)}' || die "--presend-live-cr-earn-log K must be in (0, 1] (dip34; e.g. 0.5)"
  [ -z "${PSV[--presend-live-cr-earn-log]:-}" ] || [ -n "${PSV[--presend-live-cr-loss]:-}" ] || die "--presend-live-cr-earn-log needs --presend-live-cr-loss (dip34)"
  [ -z "${PSV[--presend-live-seen-log]:-}" ] || awk -v x="${PSV[--presend-live-seen-log]}" 'BEGIN{exit !(x>0 && x<=48)}' || die "--presend-live-seen-log H must be in (0, 48] hours (dip34; e.g. 3)"
  [ -z "${PSV[--presend-live-creator-state]:-}" ] || [ -f "${PSV[--presend-live-creator-state]}" ] || echo "NOTE: ${PSV[--presend-live-creator-state]} does not exist yet: the creator ledger starts EMPTY (saved there during the run)" >&2
  [ -z "${PSV[--presend-live-exit-ms]:-}" ] || [ "${PSV[--presend-live-exit-ms]}" = 0 ] || in_range "${PSV[--presend-live-exit-ms]}" 50 2000 || die "--presend-live-exit-ms must be 0 or 50..2000"
  [ -n "${PSV[--presend-live-routes]:-}" ] || PSV[--presend-live-routes]="default=helius-ps"
  for n in $(printf %s "${PSV[--presend-live-routes]}" | tr ';' '\n' | sed 's/^[^=]*=//' | tr '+,' '\n\n'); do
    has_path "$n" || die "--presend-live-routes: no [[send]] path named $n in $BASECFG (add the attempt path's own block first: LIVE.md)"
    case "$n" in staked-rpc|nozomi|helius|helius-swqos|bolt|landx-fra3|landx-ams2|jito-bundle) die "--presend-live-routes: $n is a reactive buy / sell path: give the attempts their own [[send]] entry (LIVE.md)";; esac
  done
  # ASTRA (10-29, run 38 A/B helius-ps vs astralane-ps; ops/lanes/ASTRA_PLAN.md): the global attempt cap was 1..50 because Helius allows
  # 50/s per region over ALL its paths. It may now go up to 60 ONLY when a non-Helius path shares the attempts, and then the Helius
  # attempt paths must still be capped at <= 50/s by themselves (each Helius route entry has its own --presend-live-path-max-per-sec
  # bucket; a Helius path's [[send]] max_per_sec caps all its entries). A non-Helius attempt path must carry its own max_per_sec
  # (its provider's TPS, e.g. Astralane VIP1 20/s -> 19). With Helius-only routes nothing changes (1..50).
  RPATHS=$(printf %s "${PSV[--presend-live-routes]}" | tr ';' '\n' | sed 's/^[^=]*=//' | tr '+,' '\n\n' | grep .)
  PMAX=${PSV[--presend-live-path-max-per-sec]:-10}; NONHEL=0; HELCAP=0
  for n in $(printf '%s\n' "$RPATHS" | sort -u); do
    if [ "$(path_field "$n" kind)" = helius ]; then
      e=$(printf '%s\n' "$RPATHS" | grep -cx "$n"); c=$(path_field "$n" max_per_sec)
      HELCAP=$(awk -v h="$HELCAP" -v e="$e" -v p="$PMAX" -v c="${c:-1000000}" 'BEGIN{x=e*p; if (c<x) x=c; print h+x}')
    else
      NONHEL=$((NONHEL + 1))
      [ -n "$(path_field "$n" max_per_sec)" ] || die "--presend-live-routes: $n has no max_per_sec in its [[send]] block (a non-Helius attempt path needs its provider's TPS cap)"
    fi
  done
  GMAX=50; [ "$NONHEL" -gt 0 ] && GMAX=60
  [ -z "${PSV[--presend-live-max-per-sec]:-}" ] || in_range "${PSV[--presend-live-max-per-sec]}" 1 $GMAX || die "--presend-live-max-per-sec must be 1..$GMAX (50 with Helius paths only: Helius allows 50/s per region over ALL its paths; up to 60 when a non-Helius path shares the attempts)"
  if awk -v g="${PSV[--presend-live-max-per-sec]:-20}" 'BEGIN{exit !(g>50)}'; then
    awk -v h="$HELCAP" 'BEGIN{exit !(h<=50)}' || die "--presend-live-max-per-sec above 50 needs the Helius attempt paths capped at <= 50/s by themselves (now up to $HELCAP/s: lower --presend-live-path-max-per-sec or the Helius path's max_per_sec)"
  fi
  PSLARGS=(--presend-live); [ -n "$PSDRY" ] && PSLARGS+=(--presend-live-dry)
  for f in "${!PSV[@]}"; do PSLARGS+=("$f" "${PSV[$f]}"); done
  PSLDESC=" | PRE-SEND LIVE$( [ -n "$PSDRY" ] && echo ' DRY (never sends)' ): ${PSV[--presend-live-size-sol]} SOL, ${PSV[--presend-live-k]:-4}/slot, routes ${PSV[--presend-live-routes]}, attempt caps ${PSV[--presend-live-max-per-sec]:-20}/s global, ${PMAX}/s per route entry (Helius share <= ${HELCAP}/s) (fills cap + fee budget: see LIMITS)"
  # dip23: the QUIET v2 annotation (log-only; the records gain "v2", nothing else changes)
  if [ -n "$PSV2" ]; then PSLARGS+=(--presend-live-quiet-v2-log); PSLDESC="$PSLDESC | QUIET v2 LOG-ONLY (\"v2\" on every arm / skip record)"; fi
  # dip32: the creator ledger / breaker (live) and the f3 log
  [ -z "${PSV[--presend-live-cr-loss]:-}" ] || PSLDESC="$PSLDESC | BAD-CREATOR LEDGER ${PSV[--presend-live-cr-loss]} (state ${PSV[--presend-live-creator-state]:-none})"
  [ -z "${PSV[--presend-live-breaker]:-}" ] || PSLDESC="$PSLDESC | CIRCUIT BREAKER ${PSV[--presend-live-breaker]}"
  [ "${PSV[--presend-live-quiet3a]:-off}" = off ] || PSLDESC="$PSLDESC | QUIET3-A LIVE"
  if [ -n "$PSF3" ]; then PSLARGS+=(--presend-live-f3-log); PSLDESC="$PSLDESC | F3 LOG-ONLY (QUIET3-A, fresh holders)"; fi
  # dip34: the exact exit (engine default on) and the log-only annotations
  [ -z "${PSV[--presend-live-exit-ms]:-}" ] || [ "${PSV[--presend-live-exit-ms]}" = 0 ] || PSLDESC="$PSLDESC | EXIT ${PSV[--presend-live-exit-ms]} ms ($( [ "${PSV[--presend-live-exact-exit]:-on}" = on ] && echo 'exact clock' || echo 'feed-driven, dip33 timing'))"
  [ -z "${PSV[--presend-live-cr-earn-log]:-}" ] || PSLDESC="$PSLDESC | CR-EARNBACK LOG k=${PSV[--presend-live-cr-earn-log]}"
  [ -z "${PSV[--presend-live-seen-log]:-}" ] || PSLDESC="$PSLDESC | SEEN-WHALE LOG ${PSV[--presend-live-seen-log]} h"
  if [ -n "$PSEQ" ]; then PSLARGS+=(--presend-live-eqgrp-log); PSLDESC="$PSLDESC | EQ-GROUP LOG"; fi
  if [ -n "$PSQ4" ]; then PSLARGS+=(--presend-live-q4-log); PSLDESC="$PSLDESC | QUIET4 LOG"; fi
else
  [ -z "$PSDRY" ] && [ ${#PSV[@]} -eq 0 ] || die "--presend-live-* options need --presend-live"
  [ -z "$PSV2" ] || die "--presend-quiet-v2-log needs --presend-live (it annotates the live pre-send arm / skip records)"
  [ -z "$PSF3" ] || die "--presend-live-f3-log needs --presend-live"
  [ -z "$PSEQ$PSQ4" ] || die "--presend-live-eqgrp-log / --presend-live-q4-log need --presend-live"
fi
# QUIET (dip20): the owner's config, opt-in; the follower-bot list must be on the server; the preload only where the recorder runs
QARGS=(); QDESC=""
if [ -n "$PSQUIET" ]; then
  [ -n "$PSLIVE" ] || die "--presend-quiet needs --presend-live (it filters the live pre-send windows)"
  QFB=$QFBV
  [[ "$QSTOPV" =~ ^[0-9]+:[0-9]+$ ]] || die "--quiet-stop N:M"
  awk -v x="$QFOLV" 'BEGIN{exit !(x>0 && x<=50)}' || die "--quiet-fol must be in (0, 50]"
  [ -f "$QFB" ] || die "--presend-quiet: missing $QFB (copy ops/strategies/presend/filter/fbots_frozen.json there first)"
  QARGS=(--presend-live-quiet-stop "$QSTOPV" --presend-live-quiet-skip on --presend-live-quiet-hist-h 24 --presend-live-quiet-fol "$QFOLV" --presend-live-quiet-warmup-min 60 --presend-live-fbots "$QFB")
  # dip21: the host's book of the whale history (pushed by the host after each keeper pass), when it is there; the region's own journal
  # (created at the first run)
  QBOOK=/root/dip/quiet_book.jsonl; QBD=""
  if [ -f "$QBOOK" ]; then QARGS+=(--presend-live-quiet-book "$QBOOK"); QBD="the host's book $QBOOK + "; fi
  QSTATE=/root/dip/quiet_state_${REGION}.jsonl
  QARGS+=(--presend-live-quiet-state "$QSTATE")
  QPRE=/root/sniper-collect/current_run
  if [ -f "$QPRE" ] && [ -d "/root/sniper-collect/$(cat "$QPRE")/txs" ]; then
    QARGS+=(--presend-live-quiet-preload "$QPRE"); QDESC=" | QUIET: stop $QSTOPV + arm rule (24 h / $QFOLV, fbots $QFB; whale history from ${QBD}$QSTATE + preloaded from $(cat "$QPRE"): on at once if fresh and continuous, else when merged)"
  else
    QDESC=" | QUIET: stop $QSTOPV + arm rule (24 h / $QFOLV, fbots $QFB; whale history from ${QBD}$QSTATE: on at once if it is fresh and continuous, else a 60-min warm-up)"
  fi
fi
# RE-ARM (dip26 draft, owner 10-29 19:35 PKT "add re-arm in the engine"; ops/prod/DIP26_REARM.md): live re-arm windows after a >= 6% dump while
# another wallet holds >= 6% (engine --presend-live-rearm on), opt-in. Every value is passed to the engine explicitly (the start line names it)
REARGS=(); REDESC=""
if [ -n "$PSREARM" ]; then
  [ -n "$PSLIVE" ] || die "--presend-rearm needs --presend-live (its windows are live pre-send windows)"
  [ "${PSV[--presend-live-one-position]:-on}" = on ] || die "--presend-rearm needs --presend-live-one-position on (never two positions at once)"
  RESIZE=${PSREARMSIZE:-${PSV[--presend-live-size-sol]}}
  num "$RESIZE" && in_range "$RESIZE" 0.05 1.0 || die "--presend-rearm-size must be 0.05..1.0 SOL (got '$RESIZE')"
  REGAP=${PSREARMGAP:-20}
  [[ "$REGAP" =~ ^[0-9]+$ ]] && [ "$REGAP" -ge 1 ] && [ "$REGAP" -le 60 ] || die "--presend-rearm-gap must be 1..60 slots (the window's last slot = dump + 3 + G; got '$REGAP')"
  REQ=${PSREARMQ:-6:2}
  { [[ "$REQ" =~ ^([0-9]+):([0-9]+)$ ]] && [ "${BASH_REMATCH[1]}" -ge 1 ] && [ "${BASH_REMATCH[1]}" -le 30 ] && [ "${BASH_REMATCH[2]}" -ge 1 ] && [ "${BASH_REMATCH[2]}" -le 100 ]; } \
    || die "--presend-rearm-quiet must be N:M (N 1..30 slots, M 1..100 trades; got '$REQ')"
  RER5=${PSREARMR5:-off}
  [[ "$RER5" =~ ^(on|off)$ ]] || die "--presend-rearm-r5 on|off (got '$RER5')"
  [ "$RER5" = off ] || [ -n "$PSQUIET" ] || die "--presend-rearm-r5 on needs --presend-quiet (the QUIET arm rule's whale history, cohort and follower-bot lists)"
  # its size is a buy size: part of the per-buy cap (--max-sol = the largest size x 1.05) and of the 1.5 SOL usable budget
  MAXSIZE=$(awk -v a="$MAXSIZE" -v b="$RESIZE" 'BEGIN{print (b>a)?b:a}')
  awk -v s="$MAXSIZE" -v o="$OPEN" 'BEGIN{exit !(s*o <= 1.5)}' || die "the re-arm size x open positions exceeds the 1.5 SOL usable budget"
  REARGS=(--presend-live-rearm on --presend-live-rearm-size-sol "$RESIZE" --presend-live-rearm-gap-slots "$REGAP" --presend-live-rearm-quiet-stop "$REQ" --presend-live-rearm-r5-skip "$RER5")
  REDESC=" | RE-ARM ON: after a >= 6% dump on a token <= 30 s old while another wallet holds >= 6% -> window to dump+3+$REGAP at $RESIZE SOL, QUIET $REQ, R5 skip $RER5"
else
  [ -z "$PSREARMSIZE$PSREARMGAP$PSREARMQ$PSREARMR5" ] || die "--presend-rearm-size / --presend-rearm-gap / --presend-rearm-quiet / --presend-rearm-r5 need --presend-rearm"
fi
SFARGS=(); SFDESC=""
if [ -n "$SELLFAN" ]; then
  for n in $(printf %s "$SELLFAN" | tr ',+' '\n\n'); do
    has_path "$n" || die "--sell-fanout: no [[send]] path named $n in $BASECFG"
    [ "$n" != staked-rpc ] || die "--sell-fanout staked-rpc: that is the --sell-path itself"
  done
  SFARGS=(--sell-fanout "$SELLFAN"); SFDESC=" | SELL FAN-OUT staked-rpc + $SELLFAN (one signature)"
fi
# routes presets (v8 = the default string above)
case "$ROUTES" in
  # v10 (10-25 ~22:10 PKT, from the probes ops/dip/speed/landing2/PROBES_V2.md: falcon 86-100% same block on Jito / Harmonic; helius-swqos best of
  #   the old lanes on Jito; jito-tx, staked-rpc, nextblock drop off Jito; glaive left out until it is tested inside the nonce fan-out)
  # v13 (10-26 ~04:10 PKT, owner signed up to 0slot "lets doooo this"): v12 + 0slot (staked_conn, http, 5/s, tip 0.001) on every
  #   main leader type; MARKET_SCAN: 0slot is the fastest pros' lane on Firedancer leaders (35.7 ms), so it leads the fd route
  v13) ROUTES="bam=nozomi+helius-swqos+bolt+falcon+falcon-udp+soyas+solami+0slot;jito=solami+soyas+glaive+falcon+falcon-udp+helius-swqos+0slot;harmonic=nozomi+landx-fra3+falcon+falcon-udp+glaive+soyas+solami+0slot;fd=0slot+nozomi+landx-fra3+staked-rpc+soyas+solami;agave=nozomi+helius-swqos+bolt+staked-rpc;other=nozomi+helius-swqos+bolt+staked-rpc;default=nozomi+helius-swqos+bolt+staked-rpc";;
  # v12 (10-26 ~02:45 PKT, owner: "run both live with new dip senders, we will test live"): the pros' lanes added where they win
  #   (CLIENT_ACTIONS B3, Jito-relayer leaders: solami 16 / soyas 22 / glaive 26 ms vs us 72); tonight's winners kept (nozomi on
  #   Harmonic / BAM, falcon on Jito, landx on Harmonic / FD); helius (Sender Max) dropped from Jito (0 of 5 Jito landings)
  v12) ROUTES="bam=nozomi+helius-swqos+bolt+falcon+falcon-udp+soyas+solami;jito=solami+soyas+glaive+falcon+falcon-udp+helius-swqos;harmonic=nozomi+landx-fra3+falcon+falcon-udp+glaive+soyas+solami;fd=nozomi+landx-fra3+staked-rpc+soyas+solami;agave=nozomi+helius-swqos+bolt+staked-rpc;other=nozomi+helius-swqos+bolt+staked-rpc;default=nozomi+helius-swqos+bolt+staked-rpc";;
  # v11 (10-26 ~00:10 PKT) = v10 + Falcon's native UDP lane (dip18 kind falcon-udp) next to falcon HTTP wherever falcon is: same key,
  #   same tip group (one tip per copy), the HTTP copy stays as the fallback while UDP is unproven (UDP never says why it drops)
  v11) ROUTES="bam=nozomi+helius-swqos+bolt+falcon+falcon-udp;jito=falcon+falcon-udp+helius-swqos+helius;harmonic=nozomi+falcon+falcon-udp+landx-fra3;fd=nozomi+landx-fra3+staked-rpc;agave=nozomi+helius-swqos+bolt+staked-rpc;other=nozomi+helius-swqos+bolt+staked-rpc;default=nozomi+helius-swqos+bolt+staked-rpc";;
  v10) ROUTES="bam=nozomi+helius-swqos+bolt+falcon;jito=falcon+helius-swqos+helius;harmonic=nozomi+falcon+landx-fra3;fd=nozomi+landx-fra3+staked-rpc;agave=nozomi+helius-swqos+bolt+staked-rpc;other=nozomi+helius-swqos+bolt+staked-rpc;default=nozomi+helius-swqos+bolt+staked-rpc";;
  v9) ROUTES="bam=nozomi+helius-swqos+bolt;jito=helius+helius-swqos+staked-rpc;harmonic=nozomi+landx-fra3;fd=nozomi+landx-fra3+staked-rpc;agave=nozomi+helius-swqos+bolt+staked-rpc;other=nozomi+helius-swqos+bolt+staked-rpc;default=nozomi+helius-swqos+bolt+staked-rpc";;
  v8|"") ROUTES="bam=nozomi+helius-swqos+bolt+staked-rpc;jito=helius+nozomi+jito-bundle+staked-rpc;harmonic=nozomi+helius-swqos+landx-fra3+staked-rpc;fd=nozomi+landx-fra3+staked-rpc;agave=nozomi+helius-swqos+bolt+staked-rpc;other=nozomi+helius-swqos+bolt+staked-rpc;default=nozomi+helius-swqos+bolt+staked-rpc";;
esac
# ---- dip14 (SPEED FIXES): every option checked before the engine starts
D14ARGS=(); D14DESC=""
clientlist() { [[ "$1" =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]]; }
if [ -n "$SHRED" ]; then
  [[ "$SHRED" =~ ^(shadow|live)$ ]] || die "--shred-fire shadow|live"
  D14ARGS+=(--dip-shred-fire "$SHRED")
  case "${SHREDIDX:-exact}" in
    exact) [ -z "$SHREDWIN$SHREDMARGIN" ] || die "--shred-window / --shred-margin need --shred-index window"; D14DESC=" | SHRED FIRE $SHRED (index exact)";;
    window) [ -z "$SHREDWIN" ] || { [[ "$SHREDWIN" =~ ^[0-9]+$ ]] && [ "$SHREDWIN" -ge 1 ] && [ "$SHREDWIN" -le 2000 ]; } || die "--shred-window must be 1..2000 txs"
            [ -z "$SHREDMARGIN" ] || { [[ "$SHREDMARGIN" =~ ^[0-9]+$ ]] && [ "$SHREDMARGIN" -le 400 ]; } || die "--shred-margin must be 0..400 txs"
            D14ARGS+=(--dip-shred-index window); [ -n "$SHREDWIN" ] && D14ARGS+=(--dip-shred-window "$SHREDWIN"); [ -n "$SHREDMARGIN" ] && D14ARGS+=(--dip-shred-margin "$SHREDMARGIN")
            D14DESC=" | SHRED FIRE $SHRED (index window ${SHREDMARGIN:-40}/${SHREDWIN:-100})";;
    *) die "--shred-index exact|window";;
  esac
  if [ -n "$SHREDSELLER" ]; then [[ "$SHREDSELLER" =~ ^(on|off)$ ]] || die "--shred-seller-check on|off"; D14ARGS+=(--dip-shred-seller-check "$SHREDSELLER"); fi
  [ "$SHRED" = live ] && echo "NOTE: --shred-fire live BUYS on the shred sighting (owner's decision; shadow first: FIXES.md)"
else
  [ -z "$SHREDIDX$SHREDWIN$SHREDMARGIN$SHREDSELLER" ] || die "--shred-index / --shred-window / --shred-margin / --shred-seller-check need --shred-fire"
fi
if [ -n "$SKIPCL" ]; then clientlist "$SKIPCL" || die "--skip-clients: a comma list of client names / classes (e.g. Rakurai)"; D14ARGS+=(--dip-skip-clients "$SKIPCL"); D14DESC="$D14DESC | skip leaders $SKIPCL"; fi
[ -n "$DEFER" ] && { D14ARGS+=(--dip-defer); D14DESC="$D14DESC | defer"; }
if [ -n "$BUSY" ]; then
  D14ARGS+=(--dip-busy-poll); D14DESC="$D14DESC | busy-poll"
  if [ -n "$PINCORE" ]; then [[ "$PINCORE" =~ ^[0-9]+$ ]] && [ "$PINCORE" -lt "$(nproc)" ] || die "--pin-core must be a core number below $(nproc)"; D14ARGS+=(--pin-core "$PINCORE"); D14DESC="$D14DESC core $PINCORE"; fi
else
  [ -z "$PINCORE" ] || die "--pin-core needs --busy-poll"
fi
[ -n "$FEEDLAG" ] && { D14ARGS+=(--dip-feed-lag); D14DESC="$D14DESC | feed-lag"; }
if [ -n "$PROBE" ]; then
  [[ "$PROBE" =~ ^[0-9]+$ ]] && [ "$PROBE" -ge 1 ] && [ "$PROBE" -le 200 ] || die "--probe must be 1..200 probes"
  [ -z "$SHRED" ] || die "--probe with --shred-fire: run them separately"
  [ -z "$PSLIVE" ] || die "--probe with --presend-live: run them separately"
  [ -n "$PROBEPATHS" ] || die "--probe needs --probe-paths a,b,c (one path per probe, rotated)"
  for n in $(printf %s "$PROBEPATHS" | tr ',' '\n'); do has_path "$n" || die "--probe-paths: no [[send]] path named $n in $BASECFG"; done
  D14ARGS+=(--dip-probe "$PROBE" --dip-probe-paths "$PROBEPATHS")
  if [ -n "$PROBECL" ]; then clientlist "$PROBECL" || die "--probe-clients: a comma list of client names / classes (e.g. jito)"; D14ARGS+=(--dip-probe-clients "$PROBECL"); fi
  if [ -n "$PROBETIPLESS" ]; then
    [[ "$PROBETIPLESS" =~ ^(on|off)$ ]] || die "--probe-tipless on|off"
    [ "$PROBETIPLESS" = off ] || ! printf %s ",$PROBEPATHS," | grep -q ',staked-rpc,' || die "--probe-tipless on: drop staked-rpc from --probe-paths (it has no tip: its twin is the same tx)"
    D14ARGS+=(--dip-probe-tipless "$PROBETIPLESS")
  fi
  if [ -n "$PROBEGAP" ]; then [[ "$PROBEGAP" =~ ^[0-9]+$ ]] && [ "$PROBEGAP" -ge 500 ] && [ "$PROBEGAP" -le 10000 ] || die "--probe-gap-ms must be 500..10000"; D14ARGS+=(--dip-probe-gap-ms "$PROBEGAP"); fi
  CLOCK2=1
  D14DESC="$D14DESC | LANDING PROBES x$PROBE (cannot fill: ~0.0005 SOL per landed one) paths $PROBEPATHS${PROBECL:+ on $PROBECL leaders}$( [ "$PROBETIPLESS" = on ] && echo ' + tipless twins' )"
else
  [ -z "$PROBEPATHS$PROBECL$PROBETIPLESS$PROBEGAP" ] || die "--probe-paths / --probe-clients / --probe-tipless / --probe-gap-ms need --probe N"
fi
[ -n "$CLOCK2" ] && { D14ARGS+=(--dip-clock2); D14DESC="$D14DESC | clock2"; }
# backup RPC of the exit path (see BACKUP RPC above)
if [ "$FALLBACK" = ck ]; then
  case "$REGION" in fra) CKO=amsterdam;; ams) CKO=frankfurt;; esac
  export CK_STANDBY_URL="https://rpc-$CKO.constant-k.com/?api-key=\${CONSTANTK_TOKEN}"   # literal ${...}: the engine fills it in
  FBVAR=CK_STANDBY_URL; FBDESC="Constant-K $CKO"
else
  [[ "$FALLBACK" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "--fallback ck | ENV_VAR_NAME (got '$FALLBACK')"
  FBVAR=$FALLBACK; FBDESC=$FALLBACK
fi
B=/root/sniper-dip/snipe_engine_dip10
M2ARGS=(); M2DESC=""
if [ -n "$M2" ]; then
  [ -s "$M2" ] || die "--m2 $M2: missing or empty (the M2 bundle json)"
  [[ "$M2MODE" =~ ^(shadow|gate)$ ]] || die "--m2-mode shadow|gate (got '$M2MODE')"
  B=/root/sniper-dip/snipe_engine_dip11
  M2ARGS=(--dip-m2 "$M2" --dip-m2-mode "$M2MODE")
  if [ -n "$M2MIN" ]; then [[ "$M2MIN" =~ ^-?[0-9]*[.]?[0-9]+$ ]] || die "--m2-min: not a number"; M2ARGS+=(--dip-m2-min "$M2MIN"); fi
  if [ -n "$M2EXTRA" ]; then [[ "$M2EXTRA" =~ ^(on|off)$ ]] || die "--m2-extra on|off"; M2ARGS+=(--dip-m2-extra "$M2EXTRA"); fi
  M2DESC=" | M2 detector: $( [ "$M2MODE" = gate ] && echo 'GATE (M2 decides the buys)' || echo 'shadow (logs only, IMIT1 trades)' ) $M2${M2MIN:+ min $M2MIN}"
fi
PSARGS=(); PSDESC=""
if [ -n "$PRESEND" ]; then B=/root/sniper-dip/snipe_engine_dip12; PSARGS=(--presend-shadow); PSDESC=" | PRE-SEND shadow (T2 whale buy, logs only)"; fi
# --presend-whale-pct X (owner 10-25: pre-send v2 B6 = 6): the T2 holding threshold, for the shadow AND the live trigger
if [ -n "${PSWHALE:-}" ]; then
  [ -n "$PRESEND" ] || die "--presend-whale-pct needs --presend"
  [[ "$PSWHALE" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v x="$PSWHALE" 'BEGIN{exit !(x>=3 && x<=30)}' || die "--presend-whale-pct must be 3..30 (% of supply)"
  PSARGS+=(--presend-whale-pct "$PSWHALE"); PSDESC="$PSDESC | whale >= $PSWHALE%"
fi
# dip30 --presend-wide-pct P: the WIDE shadow (log only), holdings P..whale%
if [ -n "${PSWIDE:-}" ]; then
  [ -n "$PRESEND" ] || die "--presend-wide-pct needs --presend"
  [[ "$PSWIDE" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v x="$PSWIDE" -v w="${PSWHALE:-5}" 'BEGIN{exit !(x>=1 && x<w)}' || die "--presend-wide-pct must be in [1, the whale pct)"
  PSARGS+=(--presend-wide-pct "$PSWIDE"); PSDESC="$PSDESC | WIDE shadow (log only) $PSWIDE..${PSWHALE:-5}%"
fi
# dip34 --presend-move-log: the shadow's presend_disarm records get "move" (log only)
if [ -n "$PSMOVE" ]; then
  [ -n "$PRESEND" ] || die "--presend-move-log needs --presend"
  PSARGS+=(--presend-move-log); PSDESC="$PSDESC | MOVE LOG (shadow disarms)"
fi
# --presend-tp X (owner 10-28 23:15 PKT: "start with 20% tp"): the pre-send take-profit, for the shadow AND the live exit
# (engine default 0.10; 0 = off). The slot limit / --presend-live-exit-ms / SL 20% are unchanged.
if [ -n "${PSTP:-}" ]; then
  [ -n "$PRESEND" ] || die "--presend-tp needs --presend"
  [[ "$PSTP" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v x="$PSTP" 'BEGIN{exit !(x==0 || (x>=0.02 && x<=1.0))}' || die "--presend-tp must be 0 (off) or 0.02..1.0 (fraction, e.g. 0.20)"
  PSARGS+=(--presend-tp "$PSTP"); PSDESC="$PSDESC | pre-send TP $(awk -v x="$PSTP" 'BEGIN{printf "%d%%", x*100}')"
fi
# ---- dip16 (owner 10-25 ~19:50 PKT "ok"; ops/dip/speed/landing2/CLIENT_ACTIONS.md C1 C3 C4 B4 C5 + the glaive kind): all off unless given
USE16=
if [ -n "${D16V[--loaded-data-limit]:-}" ]; then
  [[ "${D16V[--loaded-data-limit]}" =~ ^[0-9]+$ ]] && [ "${D16V[--loaded-data-limit]}" -ge 13631488 ] || die "--loaded-data-limit BYTES must be >= 13 MiB (our buy loads ~12.5 MB; 16777216 recommended)"
  D14ARGS+=(--loaded-data-limit "${D16V[--loaded-data-limit]}"); D14DESC="$D14DESC | loaded-data limit ${D16V[--loaded-data-limit]}"; USE16=1
fi
[ -n "$D16RH" ] && { D14ARGS+=(--log-route-headers); D14DESC="$D14DESC | route headers"; USE16=1; }
[ -n "$D16WC" ] && { D14ARGS+=(--window-clock); D14DESC="$D14DESC | window clock"; USE16=1; }
if [ -n "${D16V[--probe-nonce]:-}" ]; then
  [ -n "$PROBE" ] || die "--probe-nonce needs --probe N"; [[ "${D16V[--probe-nonce]}" =~ ^(on|ab)$ ]] || die "--probe-nonce on|ab"; [ -n "$NONCE" ] || die "--probe-nonce needs --nonce FILE"
  [ "$PROBETIPLESS" != on ] || die "--probe-nonce with --probe-tipless: run them separately"
  D14ARGS+=(--dip-probe-nonce "${D16V[--probe-nonce]}"); D14DESC="$D14DESC | probe nonce ${D16V[--probe-nonce]}"; USE16=1
fi
if [ -n "${D16V[--probe-lock-only]:-}" ]; then
  [ -n "$PROBE" ] || die "--probe-lock-only needs --probe N"; [ "${D16V[--probe-lock-only]}" = on ] || die "--probe-lock-only on"; [ "$PROBETIPLESS" != on ] || die "--probe-lock-only with --probe-tipless: run them separately"
  D14ARGS+=(--dip-probe-lock-only on); [ -z "${D16V[--probe-lock-cu]:-}" ] || D14ARGS+=(--dip-probe-lock-cu "${D16V[--probe-lock-cu]}")
  D14DESC="$D14DESC | LOCK-ONLY probes (they succeed: a landed one pays its tip)"; USE16=1
fi
# the glaive kind exists from dip16 only, so its [[send]] entries live in a side file appended to THIS run's config when named
GLAIVE_SIDE=/root/sniper-dip/paths_glaive.toml
if printf %s ",$PROBEPATHS,$ROUTES," | grep -q 'glaive'; then [ -f "$GLAIVE_SIDE" ] || die "missing $GLAIVE_SIDE"; USE16=1; fi
# the falcon-udp kind exists from dip18 only (dip17 + Falcon native UDP, owner 10-25 ~23:30 PKT "yes"): same side-file pattern
FUDP_SIDE=/root/sniper-dip/paths_falcon_udp.toml
USE18=
if printf %s ",$PROBEPATHS,$ROUTES," | grep -q 'falcon-udp'; then [ -f "$FUDP_SIDE" ] || die "missing $FUDP_SIDE"; USE18=1; fi
# Soyas / Solami QUIC lanes (dip17 kinds, inside dip18; keys SOYAS_KEYPAIR / SOLAMI_KEYPAIR in the .env; connect check PASSED 10-26 02:20 PKT)
QUIC_SIDE=/root/sniper-dip/paths_quic.toml
USEQ=
if printf %s ",$PROBEPATHS,$ROUTES," | grep -qE 'soyas|solami'; then [ -f "$QUIC_SIDE" ] || die "missing $QUIC_SIDE"; USE18=1; USEQ=1; fi
# dip13 = dip12 + the pre-send LIVE probe + the sell fan-out
if [ -n "$PSLIVE" ] || [ -n "$SELLFAN" ]; then B=/root/sniper-dip/snipe_engine_dip13; fi
# dip14 = dip13 + the SPEED FIXES (shred fire, skip clients, defer, busy-poll, clock2, feed-lag, probe filters / tipless twins)
if [ ${#D14ARGS[@]} -gt 0 ]; then B=/root/sniper-dip/snipe_engine_dip14; fi
# dip15 = dip14 + two pre-send fixes (owner 10-25 ~19:10 PKT "fix those"): the run ends 20 s after the pre-send stop even if
# its bookkeeping never settles (AMS run 17 never exited), and an empty --presend-live-routes class is refused at start (it
# crashed the sender). Every pre-send LIVE probe and every dip14 option runs on it; nothing else changes.
if [ -n "$PSLIVE" ] || [ ${#D14ARGS[@]} -gt 0 ]; then B=/root/sniper-dip/snipe_engine_dip15; fi
# dip16 = dip15 + C1 / C3 / C4 / B4 / C5 flags and the glaive kind (with no new flag its txs are byte-identical to dip15, golden test)
[ -z "$USE16" ] || B=/root/sniper-dip/snipe_engine_dip16
# dip18 = dip16 + the soyas / solami QUIC kinds (dip17, unused here) + the falcon-udp kind; no new kind named => txs byte-identical (golden test)
[ -z "$USE18" ] || B=/root/sniper-dip/snipe_engine_dip18
# dip19 = dip18 + the pre-send double-fill fix (10-26, FRA run 22 left 11.8M tokens unsold): a pre-send sell keeps the token account
# (the guard) until every attempt is past its deadline, a late fill gets its own sell, every window is re-checked, P&L counts every buy,
# run-end check of every pre-send mint. Pre-send LIVE runs ONLY on dip19; with pre-send live off its txs equal dip18's (golden test)
if [ -n "$PSLIVE" ] || [ -n "$USE18" ]; then B=/root/sniper-dip/snipe_engine_dip19; fi
# dip20 = dip19 + QUIET (the pre-send filter; every part behind its own flag, off by default: flags off = dip19's records, golden test).
# dip21 = dip20 + the QUIET history at the start: the host's book (--presend-live-quiet-book) and the state journal (--presend-live-quiet-state);
# without both, dip20's records (golden test). Only --presend-quiet selects it
[ -z "$PSQUIET" ] || B=/root/sniper-dip/snipe_engine_dip21
# dip22 = dip21 + --presend-live-exit-ms (the pre-send "sell earlier" exit; off by default = dip21). Only that flag selects it
[ -z "${PSV[--presend-live-exit-ms]:-}" ] || [ "${PSV[--presend-live-exit-ms]}" = 0 ] || B=/root/sniper-dip/snipe_engine_dip22
# dip23 = dip22 + --presend-live-quiet-v2-log (the QUIET v2 annotation, LOG ONLY; off by default = dip22). Only --presend-quiet-v2-log selects it
[ -z "$PSV2" ] || B=/root/sniper-dip/snipe_engine_dip23
# dip24 (owner 10-29 PKT) = dip23 + OBSERVATORY (--observatory --obs-watch) + REGULAR MODE (--dip-regular, --dip-regular-paper-ms) + the
# new limits (--minutes 0 = no time limit, --max-buys 0 = unlimited, the optional pre-send fills cap and rolling 24 h fee budget, the
# profit lock --profit-lock-min-sol / --profit-lock-frac); with none of the new flags it behaves as dip23. dip24 is a SUPERSET of every
# engine chosen above, so THIS DRAFT ALWAYS RUNS dip24: the selection lines above are kept for history only (the side files they flag
# are still appended below)
# dip25 (10-29 PKT) = dip24 + --presend-live-min-age-slots (off by default = dip24) + the INSLOT dedup fix (observatory, log only)
B=/root/sniper-dip/snipe_engine_dip25
# dip26 (10-29 PKT) = dip25 + the LIVE RE-ARM (--presend-live-rearm*; off unless --presend-rearm: then dip25's records byte for byte, golden test)
B=/root/sniper-dip/snipe_engine_dip26
# dip27 (10-30 PKT) = dip26 + --presend-live-lone-whale-slots + --presend-live-ann (both off unless given: then dip26's records, golden test)
B=/root/sniper-dip/snipe_engine_dip27
# dip28 (10-30 PKT) = dip27 + --presend-live-deep-drop + --presend-live-holds-state (both off unless given: then dip27's records, golden test)
B=/root/sniper-dip/snipe_engine_dip28
# dip29 (10-30) = dip28 + filter log lines (DEEP-LIMIT NO-FILL, FLAGS per fill); same flags
B=/root/sniper-dip/snipe_engine_dip29
# dip30 (10-30) = dip29 + --presend-wide-pct (the wide shadow, log only; off unless given)
B=/root/sniper-dip/snipe_engine_dip30
# dip32 (11-03) = dip30 + the circuit breaker (dip31) + the creator ledger / gate + the f3 log (all off unless given: then dip30's records)
B=/root/sniper-dip/snipe_engine_dip32
# dip33 (11-03) = dip32 + --presend-live-quiet3a (QUIET3-A live) + --presend-live-tag-wallets / f3 "r41" (log); off unless given
B=/root/sniper-dip/snipe_engine_dip33
# dip34 (11-04) = dip33 + the exact exit (--presend-live-exact-exit, default on) + log-only: --presend-live-cr-earn-log, --presend-live-seen-log,
# --presend-live-eqgrp-log, --presend-live-q4-log, --presend-move-log, ann.cr_hold / cr_big (all off unless given: then dip33's records)
B=/root/sniper-dip/snipe_engine_dip34
[ -x "$B" ] || die "missing engine $B"
[ -f "$KS" ] || die "missing $KS (the prod keystore)"
[ -x "$B" ] || die "missing $B"
[ -f /root/dip/IMIT1.json ] && [ -f /root/dip/cohort_train.json ] || die "missing /root/dip/IMIT1.json or cohort_train.json"
mkdir -p /root/prod/runs
sed -e "s#^wallet *=.*#wallet          = \"$W\"#" -e "s#^wallet_keystore *=.*#wallet_keystore = \"$KS\"#" "$BASECFG" > $PC
# glaive side file (dip16 kind): appended only when this run names glaive
{ [ -n "$USE16" ] || [ -n "$USE18" ]; } && printf %s ",$PROBEPATHS,$ROUTES," | grep -q glaive && cat "$GLAIVE_SIDE" >> $PC
# falcon-udp side file (dip18 kind): appended only when this run names falcon-udp
[ -n "$USE18" ] && printf %s ",$PROBEPATHS,$ROUTES," | grep -q 'falcon-udp' && cat "$FUDP_SIDE" >> $PC
# Soyas / Solami side file (dip18): appended only when this run names soyas or solami
[ -n "$USEQ" ] && cat "$QUIC_SIDE" >> $PC
# 0slot side file (kind 0slot exists in every dip engine): appended only when this run names 0slot
ZS_SIDE=/root/sniper-dip/paths_0slot.toml
if printf %s ",$PROBEPATHS,$ROUTES," | grep -q '0slot'; then [ -f "$ZS_SIDE" ] || die "missing $ZS_SIDE"; cat "$ZS_SIDE" >> $PC; fi
# probe-only paths (enabled = false in the base config): a probe run switches on exactly the ones it names, in this run's copy
# (also the paths a ROUTES string names, e.g. falcon in routes v10)
if [ -n "$PROBEPATHS$ROUTES" ]; then
  for n in $( { printf %s "$PROBEPATHS" | tr ',' '\n'; printf %s "$ROUTES" | tr ';' '\n' | sed 's/^[^=]*=//' | tr '+' '\n'; } | sort -u); do
    awk -v n="$n" '/^\[\[send\]\]/{inb=0} $0 ~ ("^name *= *\"" n "\"") {inb=1} inb && /^enabled *= *false/ {sub(/false/, "true")} {print}' $PC > $PC.tmp && mv $PC.tmp $PC
  done
fi
grep -q "^wallet *= *\"$W\"" $PC && grep -q "^wallet_keystore *= *\"$KS\"" $PC && grep -q 'kind    = "yellowstone-tx"' $PC || die "could not build $PC"

# budget across runs (the read-only RPC helper needs its token from the .env)
CONSTANTK_TOKEN=$(bash -c 'set -a; . /root/sniper/deploy/.env; printf %s "${CONSTANTK_TOKEN:-}"'); export CONSTANTK_TOKEN
read BAL REMAIN FIRST < <(python3 - "$W" "$BUDGETF" <<'EOF'
import sys, json, os
sys.path.insert(0, "/root/indep")
from common import rpc
W = sys.argv[1]; P = sys.argv[2]
bal = rpc("getBalance", [W])["value"]
b = json.load(open(P)) if os.path.exists(P) else {"first_start": bal, "max_total_loss": 500_000_000, "runs": []}
if not os.path.exists(P): json.dump(b, open(P, "w"), indent=1)
lost = max(0, b["first_start"] - bal)
print(bal, b["max_total_loss"] - lost, b["first_start"])
EOF
)
[ -n "${BAL:-}" ] || die "could not read the wallet balance"
awk -v r="$REMAIN" 'BEGIN{exit !(r >= 50000000)}' || die "the dip budget is used up: lost $(( (FIRST-BAL)/1000000 )) mSOL of 500 since the first run"
# (dip24 draft, owner 10-29 02:10 PKT: the old check "--presend-live-fee-budget-sol <= the dip budget left" is gone: the fee budget is
# now a rolling 24 h pause of pre-send, not a run cap; the kill switch here is unchanged and still caps the loss)
awk -v b="$BAL" -v s="$MAXSIZE" 'BEGIN{exit !(b >= s*1e9 + 60000000)}' || die "balance $BAL lamports is below size + 0.06 SOL"
LOSS=$(awk -v r="$REMAIN" 'BEGIN{printf "%.4f", r/1e9}')
LAM=$(awk -v s="$SIZE" 'BEGIN{printf "%d", s*1e9}')
MAXSOL=$(awk -v s="$MAXSIZE" 'BEGIN{printf "%.4f", s*1.05}')
# --max-total-sol: the --dip engine does not use it (only the old --concurrent mode reads it). The computed budget when --trades > 0 (as
# before), else 1000 (dip24 draft: --trades 0 = unlimited, there is no count to multiply; unused in --dip mode either way)
if [ "$TRADES" -gt 0 ]; then BUDGET=$(awk -v s="$MAXSIZE" -v n="$TRADES" 'BEGIN{printf "%.3f", n*(s*1.02+0.02)+0.1}'); else BUDGET=1000; fi
TAG=${TAGP}${RUN}
OBSDESC=""; [ -z "$OBS" ] || OBSDESC=" | OBSERVATORY (log-only: rearm, hold tapes, watch list, migration, blink, backrun census) -> /root/prod/runs/$TAG.obs.jsonl"
# the regular side (dip24 draft: --regular; --trades 0 = unlimited)
case "$REGULAR" in
  off) TRDESC="size $SIZE SOL (${SIZEDEF:-from --size}; it sets --spend-lamports / --max-sol)"; TCAP="none (regular off)";;
  *)   TCAP=$( [ "$TRADES" -eq 0 ] && echo unlimited || echo "$TRADES" ); TRDESC="$TCAP trades x $SIZE SOL";;
esac
# LIMITS (dip24 draft, owner 10-29 02:10 PKT): every limit in force in this run, or none / unlimited
LIMDESC="$( [ "$MIN" -eq 0 ] && echo "no time limit (Ctrl-c / SIGTERM / the kill switch / the profit lock end it)" || echo "time $MIN min" ), regular trades cap $TCAP, pre-send fills cap $PSFC, pre-send fee budget $PSFB, $PLDESC, kill switch at -$LOSS SOL (budget left of 0.5), per-buy cap $MAXSOL SOL (--max-sol)"
echo "DIP LIVE [$REGION] run $RUN (wallet $W): $REGDESC, $TRDESC, tier $TIER, take-profit $( [ "$TP" = 99 ] && echo off || echo "+$TP" ), stop -$SL, hold $HOLD slots (~$(awk -v h=$HOLD 'BEGIN{printf "%.1f", h*0.212}') s), guard x$GUARD, open $OPEN at a time$( [ -n "$DEVLIST" ] && echo " | dev list $DEVLIST: $DEVTIER at $DEVSIZE SOL" )$( [ -n "$NEAR" ] && echo " | near leaders only: $NEAR ($(grep -c . "$NEAR") leaders)" )$( [ -n "$NONCE" ] && echo " | NONCE fan-out: $NONCE ($(grep -v '^#' "$NONCE" | grep -c '[1-9A-HJ-NP-Za-km-z]\{32,44\}') accounts)" )$M2DESC$PSDESC$PSLDESC$QDESC$REDESC$SFDESC$D14DESC$OBSDESC | LIMITS: $LIMDESC | backup RPC $FBDESC | wallet balance $(awk -v b=$BAL 'BEGIN{printf "%.4f", b/1e9}') SOL | priority ${PRIO} uL/CU | routes $ROUTES"
echo "log: /root/prod/runs/$TAG.log  records: /root/prod/runs/$TAG.jsonl$( [ -n "$OBS" ] && echo "  observatory: /root/prod/runs/$TAG.obs.jsonl (rotated to .obs.jsonl.1, .2, ... every 6 h or 1 GB, never deleted)" )"
python3 - "$RUN" "$TRADES" "$SIZE" "$BAL" "$TP" "${DEVSIZE:-0}" "$BUDGETF" "$REGION" <<'EOF'
import sys, json, time
P = sys.argv[7]; b = json.load(open(P))
b["runs"].append({"run": int(sys.argv[1]), "trades": int(sys.argv[2]), "size": float(sys.argv[3]), "start_balance": int(sys.argv[4]), "t_start": int(time.time()),
                  "tp": float(sys.argv[5]), "dev_size": float(sys.argv[6]), "region": sys.argv[8]})
json.dump(b, open(P, "w"), indent=1)
EOF
# the engine writes STRAIGHT to the log (no pipe a Ctrl-c could kill: a dead pipe makes its next log line panic and breaks
# the exit of an open position); the live view is a tail in its OWN session, so Ctrl-c reaches only the engine (no new
# buys, open positions finish their exit, then DIP DONE) and this script
LOG=/root/prod/runs/$TAG.log
: >> "$LOG"
setsid tail -n 0 -F "$LOG" &
TAILPID=$!
trap 'echo; echo "(Ctrl-c -> engine: no new buys; an open position finishes its exit; wait for PROD_DIP_DONE)"' INT
echo "the engine now asks for the keystore passphrase (hidden):"
$B --dip --live --fast-send --jito-h2 --fast-presign --fast-derive --fast-verify \
  --dip-tier $TIER --dip-allow-holder --dip-tp $TP --dip-sl $SL --dip-hold-slots $HOLD --dip-guard $GUARD --dip-spacing-slots 5 ${DEVARGS[@]+"${DEVARGS[@]}"} ${NEARARGS[@]+"${NEARARGS[@]}"} ${NONCEARGS[@]+"${NONCEARGS[@]}"} ${M2ARGS[@]+"${M2ARGS[@]}"} ${PSARGS[@]+"${PSARGS[@]}"} ${PSLARGS[@]+"${PSLARGS[@]}"} ${QARGS[@]+"${QARGS[@]}"} ${REARGS[@]+"${REARGS[@]}"} ${SFARGS[@]+"${SFARGS[@]}"} ${D14ARGS[@]+"${D14ARGS[@]}"} ${REGARGS[@]+"${REGARGS[@]}"} ${OBSARGS[@]+"${OBSARGS[@]}"} \
  --dip-model /root/dip/IMIT1.json --dip-cohort /root/dip/cohort_train.json --dip-log /root/prod/runs/$TAG.jsonl \
  --spend-lamports $LAM --max-sol $MAXSOL --max-total-sol $BUDGET --max-buys $TRADES --max-inflight $OPEN --max-loss-sol $LOSS ${PLARGS[@]+"${PLARGS[@]}"} --minutes $MIN \
  --cu-limit 100000 --cu-price-micro $PRIO --sell-cu-limit 120000 --sell-cu-price-micro 5000000 \
  --land-poll-ms 100 --land-timeout-ms 3000 --sell-robust --sell-retry-s 1 --sell-deadline-s 30 --sell-fallback-path nozomi \
  --buy-max-slot-delta 1 --rpc-fallback-url-env $FBVAR --env-name $ENVNAME --strict-balance --ks-blind-s 10 \
  --send-path helius --sell-path staked-rpc --route-by-client "$ROUTES" --no-union-harmonic \
  --config $PC --env-file /root/sniper/deploy/.env >> "$LOG" 2>&1
RC=$?
sleep 1; kill $TAILPID 2>/dev/null
trap - INT
echo "engine exit code $RC"
python3 - "$W" "$BUDGETF" <<'EOF'
import sys, json, time
sys.path.insert(0, "/root/indep")
from common import rpc
P = sys.argv[2]; b = json.load(open(P))
bal = rpc("getBalance", [sys.argv[1]])["value"]
b["runs"][-1].update(end_balance=bal, t_end=int(time.time())); json.dump(b, open(P, "w"), indent=1)
print(f"DIP run end: balance {bal / 1e9:.4f} SOL; since the first dip run {(bal - b['first_start']) / 1e9:+.4f} SOL (budget left {(b['max_total_loss'] - max(0, b['first_start'] - bal)) / 1e9:.4f} of 0.5)")
EOF
# LEFTOVER-TOKEN CHECK (10-26, after FRA run 22 left 11.8M tokens unsold): every token account of the wallet with a balance,
# read on chain after the engine exits; anything left is printed loud with the exact sell command (the engine's own checks can miss)
python3 - "$W" "$PC" <<'EOF'
import sys
sys.path.insert(0, "/root/indep")
from common import rpc
W, PC = sys.argv[1], sys.argv[2]
left, bad = [], False
for prog in ("TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb", "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"):
    r = rpc("getTokenAccountsByOwner", [W, {"programId": prog}, {"encoding": "jsonParsed", "commitment": "confirmed"}])
    if not isinstance(r, dict) or "value" not in r: bad = True; continue
    for a in r["value"]:
        i = a["account"]["data"]["parsed"]["info"]
        # frozen accounts are someone else's spam airdrop (10-26: 1B ByiDNcxM… minted to the AMS wallet, then frozen): never ours, never sold
        if i.get("state") == "frozen": continue
        if i["mint"] != "So11111111111111111111111111111111111111112" and int(i["tokenAmount"]["amount"]) > 0: left.append((i["mint"], i["tokenAmount"]["uiAmountString"]))
if bad: print("LEFTOVER-TOKEN CHECK: could not read the token accounts -- check the wallet by hand before the next run")
elif not left: print("LEFTOVER-TOKEN CHECK: no tokens left in the wallet")
else:
    print("!" * 100)
    print(f"LEFTOVER TOKENS IN THE WALLET: {len(left)} mint(s) -- SELL THEM NOW:")
    for m, ui in left: print(f"  {m}  {ui} tokens")
    print("  sudo /root/sniper-dip/snipe_engine_dip18 --sell-held " + ",".join(m for m, _ in left) + f" --live --env-name PROD --config {PC} --env-file /root/sniper/deploy/.env --send-path helius --sell-path staked-rpc --sell-fallback-path nozomi --sell-robust --sell-retry-s 1 --sell-deadline-s 60 --sell-cu-limit 120000 --sell-cu-price-micro 5000000")
    print("!" * 100)
EOF
echo PROD_DIP_DONE
