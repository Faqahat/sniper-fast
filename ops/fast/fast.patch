+            let p = match f.prepare(&l, 0, 12_345_678, [0; 6]) { Ok(p) => p, Err(e) => { eprintln!("bench prepare: {e:#}"); return; } };
+            for k in 0..5 { st[k].push(p.st[k + 1] - p.st[k]); }
+            st[5].push(p.st[5] - p.st[0]);
+            // the old path for the same launch and tips
